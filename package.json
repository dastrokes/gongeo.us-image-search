  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "manifest": "tsx src/cli.ts manifest",
    "refresh": "tsx src/cli.ts refresh",
    "index": "tsx src/cli.ts index",
    "colors": "tsx src/cli.ts colors",
    "audit": "tsx src/cli.ts audit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
