# Upstash Vector — required for sync-upstash, query-upstash, and evaluate commands
UPSTASH_VECTOR_REST_URL=https://your-index-name.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-rest-token

# Upstash Management API — only required for the --create-index flag
UPSTASH_EMAIL=you@example.com
UPSTASH_API_KEY=your-management-api-key

# Optional: override the Upstash management API base URL
# UPSTASH_VECTOR_MANAGEMENT_URL=https://api.upstash.com/v2/vector

# Path overrides — optional, defaults point to sibling repos
# TRACKER_ROOT=../gongeo.us-nikki-tracker
# CONFIG_DECODER_OUTPUT=../gongeo.us-config-decoder/cfg/config_output
